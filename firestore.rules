rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Catálogo de ejercicios: lectura para usuarios autenticados; escritura solo backend (Admin SDK).
    match /catalogs/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Perfil y estado del atleta: lectura por el dueño; escritura solo backend (Admin SDK).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      // Historial de sesiones archivadas: lectura por el dueño; escritura solo al completar vía backend.
      match /recentSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Evaluaciones de mesociclo: lectura por el dueño; escritura solo backend.
      match /evaluations/{evalId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Denegar todo lo demás por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
