{
  "name": "fitgen-backend",
  "version": "1.0.0",
  "description": "Serverless Functions for the FitGen PWA",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "emulators": "firebase emulators:start",
    "deploy": "vercel --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:billing": "vitest run --config vitest.billing.config.js",
    "test:billing:coverage": "vitest run --config vitest.billing.config.js --coverage",
    "test:billing:mutation": "stryker run stryker.billing.config.js",
    "qa:billing": "npm run test:billing:coverage && npm run test:billing:mutation",
    "test:incremental": "node scripts/dev/incremental-quality.mjs",
    "test:incremental:mutation": "node scripts/dev/incremental-quality.mjs --mutation",
    "qa:gate": "node scripts/dev/qa-quality-gate.mjs",
    "qa:mesocycle": "node scripts/dev/qa-mesocycle.mjs",
    "qa:session-bugs": "node scripts/dev/qa-session-bugs-aug2026.mjs",
    "metrics": "node scripts/dev/quality-metrics.mjs",
    "quality": "npm run test && npm run test:coverage && npm run qa:gate && npm run test:mutation && npm run metrics",
    "quality:incremental": "npm run test:incremental",
    "quality:session-bugs": "npm run qa:session-bugs && npm run quality:incremental",
    "curate-catalog": "node scripts/curateCatalog.cjs",
    "patch-catalog": "node scripts/patchCatalog.cjs",
    "upload-catalog": "node scripts/uploadCatalog.cjs",
    "verify-catalog": "node scripts/verifyCatalog.cjs",
    "verify-catalog:remote": "node scripts/verifyCatalog.cjs --remote",
    "advance-time": "node scripts/dev/advance-time.mjs",
    "qa-mesocycle": "node scripts/dev/qa-mesocycle.mjs",
    "audit-catalog": "node scripts/auditCatalogQuality.cjs",
    "audit-load-calibration": "node scripts/dev/audit-load-calibration.mjs"
  },
  "keywords": [
    "fitness",
    "llm",
    "serverless"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.967.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^3.2.7",
    "axios": "^1.13.2",
    "nodemon": "^3.1.11",
    "vercel": "^32.5.0",
    "vitest": "^3.0.9"
  }
}
