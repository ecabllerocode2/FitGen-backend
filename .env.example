# Configuración de Firebase Admin SDK
# Para desarrollo local con emuladores, puedes dejar esto vacío o comentado
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"fitgen-d94f6",...}

# Entorno de ejecución
NODE_ENV=development

# Cloudflare R2 (tarjetas de celebración, lifecycle 7d en celebrations/)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=excersises
# R2_PUBLIC_URL=https://pub-8d5fa4786e4142aab39adba9d49ee865.r2.dev

# Mercado Pago (suscripción atletas independientes $249 MXN/mes)
# MP_ACCESS_TOKEN=APP_USR-... o TEST-...
# MP_WEBHOOK_SECRET=  (firma de Webhooks en Tu integración)
# FRONTEND_URL=https://tu-dominio-frontend
# BACKEND_PUBLIC_URL=https://tu-dominio-backend  (para notification_url del webhook)
# MP_NOTIFICATION_URL=https://tu-dominio-backend/api/billing/mp/webhook  (opcional si BACKEND_PUBLIC_URL no basta)
# MP_SUBSCRIPTION_AMOUNT=249
